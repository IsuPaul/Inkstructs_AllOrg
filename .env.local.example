# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_DEFAULT_REGION=eu-west-1
VERCEL_GIT_BRANCH=main
GITHUB_TOKEN=
CUSTOMER_TEMPLATE_REPO=IsuPaul/Inkstructs_AllOrg
CUSTOMER_TEMPLATE_BRANCH=main

# Paystack (Phase 3)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Mux (Phase 2)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Optional but recommended — protects videos so only enrolled, signed-in
# students can play them. Without these, video uploads still work, just
# with public (unsigned) playback. See README "Mux setup" for how to get these.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE_KEY=

# Resend (Phase 3)
RESEND_API_KEY=
NEXT_PUBLIC_DEPLOYMENT_NAME=Inkstructs
NEXT_PUBLIC_DEPLOYMENT_LOGO_URL=
NEXT_PUBLIC_DEPLOYMENT_PRIMARY_COLOR=#e8a33d
NEXT_PUBLIC_DEPLOYMENT_DASHBOARD_URL=http://localhost:3000
